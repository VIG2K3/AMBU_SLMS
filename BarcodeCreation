    def add_table_row(self, pid, supplier, category, name, price, qty, expiry="", email="", barcode=""):
        row_position = self.table.rowCount()
        self.table.insertRow(row_position)
        
        # Get current date and time
        created_date = datetime.now().strftime("%d-%m-%Y")
        
        # Helper function to create table items with consistent properties
        def create_item(text):
            item = QTableWidgetItem(str(text))
            item.setFlags(item.flags() & ~Qt.ItemIsEditable)
            return item
        
        self.table.setItem(row_position, 0, create_item(pid))
        self.table.setItem(row_position, 1, create_item(supplier))
        self.table.setItem(row_position, 2, create_item(category))
        self.table.setItem(row_position, 3, create_item(name))
        self.table.setItem(row_position, 4, create_item(price))
        self.table.setItem(row_position, 5, create_item(qty))
        self.table.setItem(row_position, 6, create_item(expiry))
        self.table.setItem(row_position, 7, create_item(email))
        self.table.setItem(row_position, 8, create_item(barcode))
        self.table.setItem(row_position, 9, create_item(created_date))
        
        # Auto-resize columns after adding new row
        self.resize_table_columns()
    
    def save_product(self):
        try:
            supplier = self.supplier_combo.currentText()
            category = self.category_combo.currentText()
            name = self.name_input.text().strip()
            price = self.price_input.text().strip()
            qty = self.quantity_input.text().strip()
            expiry = self.expiry_date_input.text().strip()
            email = self.email_input.text().strip()
            status = self.status_combo.currentText()
            
            if supplier == "Select" or category == "Select":
                self.show_message("Error", "Please select supplier and category", QMessageBox.Warning)
                return
                
            if not name:
                self.show_message("Error", "Product name cannot be empty", QMessageBox.Warning)
                return
                
            if not price or not price.isdigit():
                self.show_message("Error", "Please enter a valid price", QMessageBox.Warning)
                return
                
            if not qty or not qty.isdigit():
                self.show_message("Error", "Please enter a valid quantity", QMessageBox.Warning)
                return
            
            if expiry and not self.validate_date(expiry):
                self.show_message("Error", "Please enter date in DD-MM-YYYY format (e.g. 30-05-2025)", QMessageBox.Warning)
                return
            
            # Email validation
            if email and not self.validate_email(email):
                self.show_message("Error", 
                    "Please enter a valid email address\n"
                    "Example: john.doe@example.com", 
                    QMessageBox.Warning)
                return
            
            # Check if product with same name already exists
            for row in range(self.table.rowCount()):
                existing_name = self.table.item(row, 3).text()
                if existing_name.lower() == name.lower():
                    reply = QMessageBox.question(self, "Confirm", 
                                               f"A product with name '{name}' already exists.\nDo you want to create a new entry with a different barcode?",
                                               QMessageBox.Yes | QMessageBox.No)
                    if reply == QMessageBox.No:
                        return
                    break
            
            new_id = 1
            if self.table.rowCount() > 0:
                last_id = int(self.table.item(self.table.rowCount()-1, 0).text())
                new_id = last_id + 1
            
            barcode_number, filename = self.barcode_gen.generate_barcode(name, price)
            
            self.add_table_row(new_id, supplier, category, name, price, qty, expiry, email, filename)
            self.clear_fields()
            self.show_message("Success", "Product saved successfully!")
            
        except Exception as e:
            self.show_message("Error", f"An error occurred: {str(e)}", QMessageBox.Critical)
    
    def update_product(self):
        try:
            selected = self.table.selectedItems()
            if not selected:
                self.show_message("Error", "Please select a row to update", QMessageBox.Warning)
                return
            
            # Confirmation prompt
            reply = QMessageBox.question(self, "Confirm Update","Are you sure you want to update this product?", QMessageBox.Yes | QMessageBox.No, QMessageBox.No)
            
            if reply != QMessageBox.Yes:
                return  # Cancel update if user clicks "No"
            
            row = selected[0].row()
            
            supplier = self.supplier_combo.currentText()
            category = self.category_combo.currentText()
            name = self.name_input.text().strip()
            price = self.price_input.text().strip()
            qty = self.quantity_input.text().strip()
            expiry = self.expiry_date_input.text().strip()
            email = self.email_input.text().strip()
            
            if supplier == "Select" or category == "Select":
                self.show_message("Error", "Please select supplier and category", QMessageBox.Warning)
                return
                
            if not name:
                self.show_message("Error", "Product name cannot be empty", QMessageBox.Warning)
                return
                
            if not price or not price.isdigit():
                self.show_message("Error", "Please enter a valid price", QMessageBox.Warning)
                return
                
            if not qty or not qty.isdigit():
                self.show_message("Error", "Please enter a valid quantity", QMessageBox.Warning)
                return
            
            if expiry and not self.validate_date(expiry):
                self.show_message("Error", "Please enter date in DD-MM-YYYY format (e.g. 30-05-2025)", QMessageBox.Warning)
                return
            
            # Email validation
            if email and not self.validate_email(email):
                self.show_message("Error", 
                    "Please enter a valid email address\n"
                    "Example: john.doe@example.com", 
                    QMessageBox.Warning)
                return
            
            self.table.item(row, 1).setText(supplier)
            self.table.item(row, 2).setText(category)
            self.table.item(row, 3).setText(name)
            self.table.item(row, 4).setText(price)
            self.table.item(row, 5).setText(qty)
            self.table.item(row, 6).setText(expiry)
            self.table.item(row, 7).setText(email)
            
            # Resize columns after update
            self.resize_table_columns()
            
            self.clear_fields()
            self.show_message("Success", "Product updated successfully!")
            
        except Exception as e:
            self.show_message("Error", f"An error occurred: {str(e)}", QMessageBox.Critical)
    
    def delete_product(self):
        selected_rows = {index.row() for index in self.table.selectedIndexes()}
        
        if not selected_rows:
            self.show_message("Error", "No rows selected", QMessageBox.Warning)
            return
        
        reply = QMessageBox.question(
            self, "Confirm Delete", 
            f"Delete {len(selected_rows)} selected product(s)?",
            QMessageBox.Yes | QMessageBox.No
        )
        
        if reply == QMessageBox.Yes:
            for row in sorted(selected_rows, reverse=True):  # Delete backwards to avoid index issues
                self.table.removeRow(row)
    
    def clear_fields(self):
        self.supplier_combo.setCurrentIndex(0)
        self.category_combo.setCurrentIndex(0)
        self.name_input.clear()
        self.price_input.clear()
        self.quantity_input.clear()
        self.expiry_date_input.clear()
        self.email_input.clear()
        self.status_combo.setCurrentIndex(0)
        self.search_input.clear()
        self.search_combo.setCurrentIndex(0)
    
    def search_products(self):
        search_type = self.search_combo.currentText()
        
        if search_type == "Select":
            self.show_message("Error", "Please select search type", QMessageBox.Warning)
            return
            
        search_term = self.search_input.text().strip()
        
        if not search_term:
            self.show_message("Error", "Please enter search term", QMessageBox.Warning)
            return
        
        for row in range(self.table.rowCount()):
            match = False
            
            if search_type == "ID":
                item = self.table.item(row, 0)
                if item and search_term.lower() in item.text().lower():
                    match = True
            elif search_type == "Name":
                item = self.table.item(row, 3)
                if item and search_term.lower() in item.text().lower():
                    match = True
            elif search_type == "Supplier":
                item = self.table.item(row, 1)
                if item and search_term.lower() in item.text().lower():
                    match = True
            elif search_type == "Category":
                item = self.table.item(row, 2)
                if item and search_term.lower() in item.text().lower():
                    match = True
            
            self.table.setRowHidden(row, not match)
    
    def show_product_details(self, row, column):
        try:
            supplier = self.table.item(row, 1).text()
            category = self.table.item(row, 2).text()
            name = self.table.item(row, 3).text()
            price = self.table.item(row, 4).text()
            qty = self.table.item(row, 5).text()
            expiry = self.table.item(row, 6).text()
            email = self.table.item(row, 7).text()
            barcode = self.table.item(row, 8).text()
            
            supplier_index = self.supplier_combo.findText(supplier)

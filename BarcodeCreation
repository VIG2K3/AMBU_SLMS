    def search_products(self):
        search_type = self.search_combo.currentText()
        
        if search_type == "Select":
            self.show_message("Error", "Please select search type", QMessageBox.Warning)
            return
            
        if search_type == "Date":
            search_date = self.date_edit.date()
            search_term = search_date.toString("dd-MM-yyyy")
        else:
            search_term = self.search_input.text().lower().strip()
            if not search_term:
                self.show_message("Error", "Please enter search term", QMessageBox.Warning)
                return
        
        for row in range(self.table.rowCount()):
            match = False
            
            if search_type == "ID":
                item = self.table.item(row, 0)
                if item and search_term in item.text().lower():
                    match = True
            elif search_type == "Name":
                item = self.table.item(row, 3)
                if item and search_term in item.text().lower():
                    match = True
            elif search_type == "Supplier":
                item = self.table.item(row, 1)
                if item and search_term in item.text().lower():
                    match = True
            elif search_type == "Category":
                item = self.table.item(row, 2)
                if item and search_term in item.text().lower():
                    match = True
            elif search_type == "Date":
                date_item = self.table.item(row, 9)  # Created date is in column 9
                if date_item:
                    item_date = QDate.fromString(date_item.text(), "dd-MM-yyyy")
                    if item_date.isValid() and item_date == search_date:
                        match = True
            
            self.table.setRowHidden(row, not match)
    
    def show_product_details(self, row, column):
        try:
            supplier = self.table.item(row, 1).text()
            category = self.table.item(row, 2).text()
            name = self.table.item(row, 3).text()
            price = self.table.item(row, 4).text()
            qty = self.table.item(row, 5).text()
            expiry = self.table.item(row, 6).text()
            email = self.table.item(row, 7).text()
            barcode = self.table.item(row, 8).text()
            
            supplier_index = self.supplier_combo.findText(supplier)
            if supplier_index >= 0:
                self.supplier_combo.setCurrentIndex(supplier_index)
            
            category_index = self.category_combo.findText(category)
            if category_index >= 0:
                self.category_combo.setCurrentIndex(category_index)
            
            self.name_input.setText(name)
            self.price_input.setText(price)
            self.quantity_input.setText(qty)
            self.expiry_date_input.setText(expiry)
            self.email_input.setText(email)
            
            if barcode:
                try:
                    pixmap = QPixmap(barcode)
                    if not pixmap.isNull():
                        self.barcode_image_label.setPixmap(pixmap.scaled(300, 100, Qt.KeepAspectRatio))
                        self.barcode_data_label.setText(f"Barcode for {name}")
                except:
                    pass
        except Exception as e:
            self.show_message("Error", f"Error loading product details: {str(e)}", QMessageBox.Critical)
    
    def show_barcode_popup(self, row, column):
        if column == 8:
            barcode_item = self.table.item(row, column)
            if barcode_item and barcode_item.text():
                barcode_path = barcode_item.text()
                self.popup = BarcodePopup(barcode_path, self)
                self.popup.show()


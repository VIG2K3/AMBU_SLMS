    def save_product(self):
        try:
            supplier = self.supplier_combo.currentText()
            category = self.category_combo.currentText()
            name = self.name_input.text().strip()
            price = self.price_input.text().strip()
            qty = self.quantity_input.text().strip()
            expiry = self.expiry_date_input.text().strip()
            email = self.email_input.text().strip()
            status = self.status_combo.currentText()
            
            if supplier == "Select" or category == "Select":
                self.show_message("Error", "Please select supplier and category", QMessageBox.Warning)
                return
                
            if not name:
                self.show_message("Error", "Product name cannot be empty", QMessageBox.Warning)
                return
                
            if not price or not price.isdigit():
                self.show_message("Error", "Please enter a valid price", QMessageBox.Warning)
                return
                
            if not qty or not qty.isdigit():
                self.show_message("Error", "Please enter a valid quantity", QMessageBox.Warning)
                return
            
            if expiry and not self.validate_date(expiry):
                self.show_message("Error", "Please enter date in DD-MM-YYYY format (e.g. 30-05-2025)", QMessageBox.Warning)
                return
            
            # Email validation
            if email and not self.validate_email(email):
                self.show_message("Error", 
                    "Please enter a valid email address\n"
                    "Example: john.doe@example.com", 
                    QMessageBox.Warning)
                return
            
            # Check if product with same name already exists
            for row in range(self.table.rowCount()):
                existing_name = self.table.item(row, 3).text()
                if existing_name.lower() == name.lower():
                    reply = QMessageBox.question(self, "Confirm", 
                                               f"A product with name '{name}' already exists.\nDo you want to create a new entry with a different barcode?",
                                               QMessageBox.Yes | QMessageBox.No)
                    if reply == QMessageBox.No:
                        return
                    break
            
            new_id = 1
            if self.table.rowCount() > 0:
                last_id = int(self.table.item(self.table.rowCount()-1, 0).text())
                new_id = last_id + 1
            
            barcode_number, filename = self.barcode_gen.generate_barcode(name, price)
            if barcode_number and filename:
                pixmap = QPixmap(filename)
                self.barcode_image_label.setPixmap(pixmap.scaled(300, 100, Qt.KeepAspectRatio))
                self.barcode_data_label.setText(f"Barcode: {barcode_number}")
            
            self.add_table_row(new_id, supplier, category, name, price, qty, expiry, email, filename)
            self.clear_fields()
            self.show_message("Success", "Product saved successfully!")
            
        except Exception as e:
            self.show_message("Error", f"An error occurred: {str(e)}", QMessageBox.Critical)
    
